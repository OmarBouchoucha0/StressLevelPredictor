{% extends 'base.html.twig' %}

{% block title %}Your Results{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-body p-5">
                <h1 class="text-center mb-5">
                    <i class="fas fa-poll-h text-primary"></i> Your Stress Assessment Results
                </h1>



                <div class="row mb-5 justify-content-center">
                    <div class="col-md-6 text-center mb-4 d-flex">
                        <div class="p-5 bg-light rounded shadow-sm flex-fill">
                            <h3 class="text-muted mb-3">Stress Category</h3>

                            {# Use the string category directly from your entity #}
                            {% set category = assessment.stressCategory|default('Unknown') %}

                            {# Set badge color based on the category string #}
                            {% set badgeClass = category == 'Low Stress' ? 'success' :
                                            (category == 'Moderate Stress' ? 'warning' :
                                            (category == 'High Stress' ? 'danger' : 'secondary')) %}

                            <h1 class="display-4">
                                <span class="badge bg-{{ badgeClass }} px-4 py-3">{{ category }}</span>
                            </h1>

                            <hr>

                            {# Display the continuous score for more detail #}
                            <div class="mt-3">
                                <p class="text-muted mb-1">Precise Intensity Score</p>
                                <h4 class="fw-bold">{{ assessment.stressLevel }}</h4>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <h3 class="mb-4">
                        Recommended Actions
                    </h3>
                    <div class="list-group">
                        {% for recommendation in recommendations %}
                        <div class="list-group-item">
                            <i class="fas fa-check-circle text-success me-2"></i>
                            {{ recommendation }}
                        </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle"></i>
                    <strong>Note:</strong> This assessment is for informational purposes only and is not a substitute
                    for professional medical advice. If you're experiencing severe stress or mental health concerns,
                    please consult with a healthcare professional.
                </div>

                <div class="d-grid gap-2">
                    <a href="{{ path('app_home') }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-home"></i> Back to Home
                    </a>
                    <a href="{{ path('app_assessment') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i> Take Another Assessment
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
